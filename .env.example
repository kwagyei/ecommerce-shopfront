# Copy to .env for local development. Never commit the real .env.
DJANGO_SECRET_KEY=generate-your-own-with-manage.py-shell
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave unset locally to use SQLite; set to the Neon connection string in production.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Stripe TEST keys only. Checkout is a server-side redirect to Stripe's hosted page,
# so only the secret key is used; without it checkout is disabled, not broken.
# STRIPE_SECRET_KEY=sk_test_...
# Milestone 4 (webhook): from `stripe listen` locally, or the dashboard endpoint.
# STRIPE_WEBHOOK_SECRET=whsec_...
