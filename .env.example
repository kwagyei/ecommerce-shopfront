# Copy to .env for local development. Never commit the real .env.
DJANGO_SECRET_KEY=generate-your-own-with-manage.py-shell
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave unset locally to use SQLite; set to the Neon connection string in production.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Stripe TEST keys only (pk_test_... / sk_test_...). Added in Milestone 3.
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
